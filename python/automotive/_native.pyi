"""Private Rust extension signatures; public documentation lives in the façade."""

from collections.abc import Awaitable
from typing import Any

class AutomotiveError(Exception): ...
class AdapterError(AutomotiveError): ...
class NotSupportedError(AutomotiveError): ...
class TransmissionCancelledError(AutomotiveError): ...
class IsoTPError(AutomotiveError): ...

class DoIPError(AutomotiveError):
    code: int | None

class UDSError(AutomotiveError): ...

class XCPError(AutomotiveError):
    response: bytes | None

class XCPTransportError(XCPError): ...

class XCPResponseError(XCPError):
    command: int
    code: int
    data: bytes

class NegativeResponseError(UDSError):
    code: int

class ProtocolDeviationError(UDSError):
    deviation: str
    response: bytes

def validate_identifier(value: int, extended: bool) -> None: ...
def validate_frame(obj: Any) -> dict[str, Any]: ...
def validate_isotp(obj: Any) -> tuple[int, bool]: ...
def validate_uds(obj: Any) -> None: ...
def resolve_bitrate(backend: str, settings: Any) -> dict[str, Any]: ...
def available_adapters() -> list[str]: ...
def enum_values() -> dict[str, dict[str, int]]: ...
def defaults() -> dict[str, Any]: ...

class _CanAdapter:
    def send(self, frame: Any) -> Awaitable[None]: ...
    def recv(self) -> _Receiver: ...
    def recv_for(self, duration: float) -> Awaitable[list[Any]]: ...
    def aclose(self) -> Awaitable[None]: ...
    @property
    def closed(self) -> bool: ...

class _Receiver:
    def next(self) -> Awaitable[Any]: ...
    def aclose(self) -> Awaitable[None]: ...

class _Transport:
    def __init__(self, adapter: _CanAdapter, config: Any) -> None: ...
    def send(self, data: bytes) -> Awaitable[None]: ...
    def recv(self) -> _Receiver: ...
    def aclose(self) -> Awaitable[None]: ...
    def uds(self, config: Any) -> _UDS: ...
    def into_device(self) -> Awaitable[_Device]: ...
    @property
    def closed(self) -> bool: ...

class _Device:
    def aclose(self) -> Awaitable[None]: ...
    @property
    def closed(self) -> bool: ...

class _UDS:
    def call(self, method: str, args: tuple[Any, ...], suppressed: bool) -> Awaitable[Any]: ...

def open_adapter(config: Any) -> _CanAdapter: ...
def connect_doip(endpoint: str, target: int, config: Any) -> Awaitable[_Transport]: ...
def discover_doip(config: Any) -> Awaitable[list[dict[str, Any]]]: ...
def bind_doip(config: Any) -> Awaitable[_DoIPDiscovery]: ...

class _DoIPDiscovery:
    def request(self) -> Awaitable[None]: ...
    def recv(self) -> Awaitable[dict[str, Any]]: ...
    def aclose(self) -> Awaitable[None]: ...
    @property
    def local_address(self) -> str: ...
    @property
    def closed(self) -> bool: ...

def validate_xcp(config: Any) -> None: ...
def validate_xcp_can(config: Any) -> None: ...
def xcp_enum_values() -> dict[str, dict[str, int]]: ...
def xcp_defaults() -> dict[str, Any]: ...

class _XCP:
    def __init__(self, transport: _XCPTransport, config: Any) -> None: ...
    def call(self, method: str, args: tuple[Any, ...]) -> Awaitable[Any]: ...
    def aclose(self) -> Awaitable[None]: ...
    @property
    def closed(self) -> bool: ...

def open_xcp_tcp(host: str, port: int, seconds: float) -> Awaitable[_XCPTransport]: ...
def open_xcp_udp(
    host: str, port: int, seconds: float, local_addr: tuple[str, int] | None = None
) -> Awaitable[_XCPTransport]: ...
def open_native_isotp(
    adapter_config: Any, isotp_config: Any, device: _Device | None = None
) -> Awaitable[_Transport]: ...

class _XCPTransport:
    def aclose(self) -> Awaitable[None]: ...
    @property
    def closed(self) -> bool: ...
    @property
    def max_tx_packet_size(self) -> int: ...
    @property
    def max_rx_packet_size(self) -> int: ...

def open_xcp_can(adapter: _CanAdapter, config: Any) -> _XCPTransport: ...

class CCPError(AutomotiveError):
    response: bytes | None

class CCPResponseError(CCPError):
    command: int
    code: int
    data: bytes

def validate_ccp(config: Any) -> None: ...
def ccp_enum_values() -> dict[str, dict[str, int]]: ...
def ccp_defaults() -> dict[str, Any]: ...

class _CCP:
    def __init__(self, adapter: _CanAdapter, config: Any) -> None: ...
    def call(self, method: str, args: tuple[Any, ...]) -> Awaitable[Any]: ...
    def aclose(self) -> Awaitable[None]: ...
    @property
    def closed(self) -> bool: ...
